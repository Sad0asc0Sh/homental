{
  "name": "homental",
  "version": "0.1.0",
  "description": "Homental — npm workspaces monorepo (API + Customer + Partners + Shared Packages)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:customer": "npm run dev --workspace=apps/customer",
    "dev:partners": "npm run dev --workspace=apps/partners",
    "build:api": "npm run build --workspace=apps/api",
    "build:customer": "npm run build --workspace=apps/customer",
    "build:partners": "npm run build --workspace=apps/partners",
    "build:all": "npm run build:api && npm run build:customer && npm run build:partners",
    "lint:api": "npm run lint --workspace=apps/api",
    "lint:customer": "npm run lint --workspace=apps/customer",
    "lint:partners": "npm run lint --workspace=apps/partners",
    "lint:all": "npm run lint:api && npm run lint:customer && npm run lint:partners",
    "typecheck:packages": "npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=packages/api-client && npm run typecheck --workspace=packages/device-bridge",
    "test:api": "npm test --workspace=apps/api -- --runInBand",
    "prisma:validate": "npm run prisma:validate --workspace=apps/api",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:deploy": "npm run prisma:deploy --workspace=apps/api",
    "prisma:seed": "npm run prisma:seed --workspace=apps/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
