# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins (localhost AND 127.0.0.1 — browsers treat them as different origins)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ── PostgreSQL + PostGIS ─────────────────────────────────────────────────────
# Matches docker-compose.yml (homental/homental_dev on localhost:5432)
DATABASE_URL=postgresql://homental:homental_dev@localhost:5432/homental

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT (secrets MUST be ≥ 32 chars; rotate for production) ───────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
# LOCAL DEVELOPMENT ONLY — echoes the OTP in the API response so you can log in
# without a real SMS. Zod fails fast at startup if NODE_ENV=production.
OTP_DEV_ECHO=true
